{
  "expo": {
    "name": "KEM-DEM",
    "slug": "kem-dem-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/app-icon.png",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.danieltoba.kemdem",
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#07131F",
        "foregroundImage": "./assets/app-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/app-icon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-mark.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#07131F",
          "dark": {
            "backgroundColor": "#07131F"
          }
        }
      ],
      "expo-sharing",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose an image to encrypt locally on this device.",
          "microphonePermission": false
        }
      ],
      "react-native-quick-crypto"
    ],
    "extra": {
      "eas": {
        "projectId": "8cf29e14-fa43-43bd-bcee-8c19d7451e0a"
      }
    }
  }
}
